# Copiez ce fichier vers .env et remplacez toutes les valeurs `change-me`.

# MariaDB
DB_NAME=user_manager
DB_USER=user_manager
DB_PASSWORD=change-me-with-a-random-password
DB_ROOT_PASSWORD=change-me-with-another-random-password

# Spring
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO
JWT_SECRET_KEY=change-me-with-at-least-32-random-characters
JWT_ENCRYPTION_KEY=change-me-with-at-least-32-other-random-characters
JWT_EXPIRE_LENGTH=3600000
JWT_REFRESH_EXPIRE_LENGTH=604800000
SPRING_DEVTOOLS_REMOTE_SECRET=change-me-for-development

# Observabilite (désactivée par défaut en local)
SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_ENABLED=false

# Déploiement Docker Compose
FEATURE_FLAGS_DEFAULT_ENABLED=true
NETWORK_NAME=user-manager-network-dev
VOLUME_PREFIX=dev-
